# Use the officially documented GISTDA API base URL.
GISTDA_API_BASE_URL=
GISTDA_API_KEY=

# Province ID is project configuration. The Pattani value used by this project
# is based on previously observed API behavior, not an official mapping.
GISTDA_PROVINCE_ID=

# Local Phase 5 PostGIS service. Keep the working password only in the ignored
# .env.phase5.local file; never commit a usable credential.
PHASE5_DB_HOST=127.0.0.1
PHASE5_DB_PORT=55432
PHASE5_DB_NAME=pattani_exposure
PHASE5_DB_USER=pattani_app
PHASE5_DB_PASSWORD=
